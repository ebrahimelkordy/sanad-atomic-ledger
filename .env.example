# ===== Sanad Atomic Ledger — Production Environment Variables =====
# Copy this file to .env and populate production secrets before startup

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://sanad_user:sanad_secure_password@localhost:5432/sanad_db?schema=public

# === Redis (for BullMQ queues & Baileys Session Auth) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === Queue Feature Flag ===
ENABLE_QUEUE=true

# === AI Orchestrator ===
# Options: groq | gemini | openai | local
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# === Security & Authentication ===
JWT_SECRET=super-secret-256-bit-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === CORS & Networking ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
PORT=3001
NODE_ENV=production
