generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerticalType {
  RESTAURANT
  PHARMACY
  RETAIL
  RETAIL_WHOLESALE
}

enum NumberRole {
  PUBLIC_SALES
  AUTHORIZED_FINANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED_INSUFFICIENT_STOCK
  CANCELLED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum PendingSettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum SaleType {
  CASH
  CREDIT
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SalaryType {
  MONTHLY
  DAILY
}

enum RateChangeReason {
  PROMOTION
  ANNUAL_RAISE
  MERIT_BONUS
  CORRECTION
  OTHER
}

enum PriceChangeReason {
  SUPPLIER_INCREASE
  MARKET_REPRICE
  PERIODIC_REVIEW
  CORRECTION
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

enum EmployeeTxType {
  ADVANCE
  DEDUCTION
  BONUS
  PAYROLL_PAYMENT
}

// ============================================================
// EXCELLENCE-DRIVEN ARCHITECTURE — RBAC, COA, OUTBOX, DOMAIN
// ============================================================

// ===========================
// 1. TENANT (Aggregate Root)
// ===========================
model Tenant {
  id                     String    @id @default(uuid()) @db.Uuid
  business_name          String
  vertical_type          VerticalType
  password_hash          String    @default("")
  created_at             DateTime  @default(now())
  closed_until_date      DateTime?
  payroll_last_run_month String?
  fiscal_tax_id          String?
  fiscal_address         String?
  commercial_registry    String?

  whatsapp_numbers    TenantWhatsAppNumber[]
  inventory_products  InventoryProduct[]
  customer_orders     CustomerOrder[]
  ledger_summaries    FinancialLedgerSummary[]
  ledger_entries      LedgerEntry[]
  pending_settlements PendingSettlement[]
  sales               Sale[]
  employees           Employee[]
  customers           Customer[]
  chat_messages       ChatMessage[]
  roles               Role[]
  permissions         Permission[]
  tenant_users        TenantUser[]
  audit_logs          AuditLog[]
  suppliers           Supplier[]
  inventory_batches   InventoryStockBatch[]
  chart_of_accounts   ChartOfAccount[]
  outbox_messages     OutboxMessage[]
  domain_events       DomainEvent[]

  @@map("tenants")
}

// =======================================
// 2. RBAC MODEL — Role / Permission / RolePermission
//    (NO Enums — Fully configurable per tenant)
// =======================================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String   // e.g. "Owner", "Finance Manager", "Inventory Lead"
  code        String   // e.g. "OWNER", "FINANCE_MANAGER" — machine-readable
  description String?
  is_system   Boolean  @default(false) // True for seeded default roles (cannot be deleted)
  created_at  DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  resource    String   // e.g. "sale", "inventory", "finance.ledger", "payroll"
  action      String   // e.g. "create", "read", "update", "delete", "approve"
  description String?
  created_at  DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role_permissions RolePermission[]

  @@unique([tenant_id, resource, action])
  @@index([tenant_id])
  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(uuid()) @db.Uuid
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  granted_at    DateTime   @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  assigned_at DateTime @default(now())

  user TenantUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@map("user_roles")
}

// =======================================
// 3. TENANT USER + AUDIT LOG
// =======================================
model TenantUser {
  id            String     @id @default(uuid()) @db.Uuid
  tenant_id     String     @db.Uuid
  name          String
  email         String
  email_normalized String  @unique
  password_hash String
  phone         String?
  status        String     @default("ACTIVE") // ACTIVE / DISABLED / LOCKED
  last_login_at DateTime?
  created_at    DateTime   @default(now())

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  roles      UserRole[]
  audit_logs AuditLog[]

  @@index([tenant_id])
  @@map("tenant_users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String?  @db.Uuid
  action_type String   // CREATE / UPDATE / DELETE / LOGIN / APPROVE / REJECT
  entity_type String   // SALE / INVOICE / LEDGER_ENTRY / PRODUCT / USER / ...
  entity_id   String?
  old_json    Json?
  new_json    Json?
  ip_address  String?
  user_agent  String?
  trace_id    String?  // For distributed tracing
  created_at  DateTime @default(now())

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   TenantUser? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, created_at])
  @@index([tenant_id, entity_type, entity_id])
  @@map("audit_logs")
}

// =======================================
// 4. CHART OF ACCOUNTS — TREE STRUCTURE
//    Self-referential + per-tenant
// =======================================
model ChartOfAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  code          String   // e.g. "1", "1.1", "1.1.1", "4.1.2" — materialized path
  name_ar       String   // Arabic name (e.g. "الأصول المتداولة")
  name_en       String?  // Optional English
  parent_id     String?  @db.Uuid
  account_type  String   // ASSET / LIABILITY / EQUITY / REVENUE / EXPENSE
  is_leaf       Boolean  @default(true) // Leaf = postings allowed
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent   ChartOfAccount?   @relation("COA_TREE", fields: [parent_id], references: [id], onDelete: Cascade)
  children ChartOfAccount[]  @relation("COA_TREE")
  ledger_entries LedgerEntry[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([tenant_id, parent_id])
  @@map("chart_of_accounts")
}

// =======================================
// 5. OUTBOX PATTERN — Reliable Async Delivery
//    (WhatsApp, Email, Reports, Webhooks, etc.)
// =======================================
model OutboxMessage {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  message_type  String   // WHATSAPP_TEXT / WHATSAPP_PDF / EMAIL_REPORT / WEBHOOK
  payload       Json     // { to, body, templateId, attachments, ... }
  priority      Int      @default(0) // 0=normal, 1=high, 2=urgent
  status        String   @default("PENDING") // PENDING / PROCESSING / SENT / FAILED / DEAD
  attempts      Int      @default(0)
  last_error    String?
  process_after DateTime? // Scheduled delivery
  sent_at       DateTime?
  created_at    DateTime @default(now())
  correlation_id String?  // Ties to domain event

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status, created_at])
  @@index([tenant_id, priority, process_after])
  @@map("outbox_messages")
}

// =======================================
// 6. DOMAIN EVENTS STORE — Event Sourcing Lite
// =======================================
model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  event_type    String   // SALE_CREATED / INVENTORY_WITHDRAWN / PAYROLL_RUN
  aggregate_id  String   // ID of root entity (e.g. sale.id)
  aggregate_type String   // SALE / INVENTORY_PRODUCT / EMPLOYEE ...
  payload       Json
  causation_id  String?  // Which command caused this
  correlation_id String?
  created_at    DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, aggregate_type, aggregate_id])
  @@index([tenant_id, event_type, created_at])
  @@map("domain_events")
}

// =======================================
// 7. SUPPLIER, INVENTORY STOCK BATCH (FIFO)
// =======================================
model InventoryStockBatch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  product_id         String   @db.Uuid
  quantity_remaining Int
  cost_per_unit      Decimal  @db.Decimal(12, 2)
  total_value        Decimal  @db.Decimal(14, 2) @default(0) // = qty * cost (maintained by trigger / service)
  expiry_date        DateTime?
  received_date      DateTime @default(now())
  supplier_id        String?  @db.Uuid
  supplier_ref       String?

  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product  InventoryProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier Supplier?        @relation(fields: [supplier_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, product_id, expiry_date])
  @@index([tenant_id, supplier_id])
  @@map("inventory_batches")
}

model Supplier {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  tax_id     String?
  phone      String?
  email      String?
  address    String?
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  payment_terms_days Int @default(30)
  created_at DateTime @default(now())

  tenant  Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  batches InventoryStockBatch[]
  products InventoryProduct[]

  @@index([tenant_id])
  @@map("suppliers")
}

// =======================================
// 8. CHAT MESSAGES, WHATSAPP NUMBERS
// =======================================
model ChatMessage {
  id                    String   @id @default(uuid()) @db.Uuid
  tenant_id             String   @db.Uuid
  sender                String   // 'user' | 'bot'
  text                  String
  attachments           Json?
  pending_action        Json?
  confirmed_state       String?  // 'confirmed' | 'rejected'
  created_at            DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("chat_messages")
}

model TenantWhatsAppNumber {
  id                String     @id @default(uuid()) @db.Uuid
  tenant_id         String     @db.Uuid
  phone_number      String
  number_role       NumberRole
  connection_status String     @default("DISCONNECTED")

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([phone_number])
  @@index([tenant_id])
  @@map("tenant_whatsapp_numbers")
}

// =======================================
// 9. CUSTOMERS, EMPLOYEES + HR
// =======================================
model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  name              String
  phone             String
  whatsapp          String?
  location_address  String?
  tax_id            String?
  credit_limit      Decimal  @default(0) @db.Decimal(12, 2)
  notes             String?
  created_at        DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  orders CustomerOrder[]
  sales  Sale[]

  @@unique([tenant_id, phone])
  @@index([tenant_id])
  @@map("customers")
}

model Employee {
  id              String      @id @default(uuid()) @db.Uuid
  tenant_id       String      @db.Uuid
  name            String
  phone           String?
  national_id     String?
  job_title       String?
  salary_type     SalaryType  @default(DAILY)
  base_rate       Decimal     @db.Decimal(12, 2)
  auto_attendance Boolean     @default(true)
  hire_date       DateTime?
  created_at      DateTime    @default(now())

  tenant        Tenant                @relation(fields: [tenant_id], references: [id])
  attendances   AttendanceRecord[]
  transactions  EmployeeTransaction[]
  rate_history  EmployeeRateHistory[]

  @@index([tenant_id])
  @@map("employees")
}

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  employee_id     String           @db.Uuid
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  overtime_hours  Decimal          @default(0) @db.Decimal(5, 2)
  check_in        DateTime?
  check_out       DateTime?
  notes           String?

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, date])
  @@index([employee_id])
  @@map("attendance_records")
}

model EmployeeTransaction {
  id          String         @id @default(uuid()) @db.Uuid
  employee_id String         @db.Uuid
  type        EmployeeTxType
  amount      Decimal        @db.Decimal(12, 2)
  period_ref  String?        // e.g. "2026-08" for payroll linkage
  notes       String?
  created_at  DateTime       @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([employee_id, period_ref])
  @@map("employee_transactions")
}

// =======================================
// 10. INVENTORY PRODUCT + HISTORY
// =======================================
model InventoryProduct {
  id                  String  @id @default(uuid()) @db.Uuid
  tenant_id           String  @db.Uuid
  name                String
  sku                 String
  current_stock       Int
  unit_price          Decimal @db.Decimal(12, 2)
  cost_price          Decimal @default(0) @db.Decimal(12, 2)
  category            String?
  barcode             String?
  low_stock_threshold Int?    // renamed from min_stock_level for clarity
  reorder_quantity    Int?
  default_supplier_id String? @db.Uuid
  is_active           Boolean @default(true)
  vertical_metadata   Json    @default("{}")
  created_at          DateTime @default(now())

  tenant        Tenant               @relation(fields: [tenant_id], references: [id])
  supplier      Supplier?            @relation(fields: [default_supplier_id], references: [id], onDelete: SetNull)
  order_details OrderDetail[]
  sale_items    SaleItem[]
  price_history ProductPriceHistory[]
  batches       InventoryStockBatch[]

  @@unique([tenant_id, sku])
  @@index([tenant_id])
  @@index([tenant_id, category])
  @@map("inventory_products")
}

// =======================================
// 11. ORDERS, SALES CYCLE
// =======================================
model CustomerOrder {
  id                         String      @id @default(uuid()) @db.Uuid
  tenant_id                  String      @db.Uuid
  customer_id                String?     @db.Uuid
  customer_whatsapp          String
  customer_name_snapshot     String?
  grand_total                Decimal     @db.Decimal(12, 2)
  order_status               OrderStatus @default(PENDING)
  source_whatsapp_message_id String      @unique
  raw_message_text           String
  rejection_reason           String?
  created_at                 DateTime    @default(now())

  tenant        Tenant        @relation(fields: [tenant_id], references: [id])
  customer      Customer?     @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  order_details OrderDetail[]
  ledger_entries LedgerEntry[]

  @@index([tenant_id])
  @@index([tenant_id, customer_whatsapp])
  @@index([tenant_id, customer_id])
  @@map("customer_orders")
}

model OrderDetail {
  id                  String  @id @default(uuid()) @db.Uuid
  order_id            String  @db.Uuid
  product_id          String  @db.Uuid
  product_snapshot    Json?   // Snapshot of product name/code at order time (for audit)
  quantity_ordered    Int
  unit_price_at_order Decimal @db.Decimal(12, 2)

  order   CustomerOrder    @relation(fields: [order_id], references: [id])
  product InventoryProduct @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@map("order_details")
}

model Sale {
  id                  String      @id @default(uuid()) @db.Uuid
  tenant_id           String      @db.Uuid
  customer_id         String?     @db.Uuid
  invoice_number      String
  customer_identifier String      // human readable for backwards-compat
  sale_type           SaleType    @default(CASH)
  status              SaleStatus  @default(CONFIRMED)
  total_amount        Decimal     @db.Decimal(12, 2)
  paid_amount         Decimal     @db.Decimal(12, 2)
  remaining_amount    Decimal     @db.Decimal(12, 2)
  total_cost          Decimal     @db.Decimal(12, 2) @default(0)
  total_profit        Decimal     @db.Decimal(12, 2)
  invoice_date        DateTime    @default(now())
  due_date            DateTime?
  reminder_count      Int         @default(0)
  last_reminder_at    DateTime?
  issued_at           DateTime?
  cancelled_at        DateTime?
  cancelled_by        String?
  created_at          DateTime    @default(now())

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  customer   Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  sale_items SaleItem[]
  payments   SalePayment[]
  ledger_entries LedgerEntry[]

  @@unique([tenant_id, invoice_number])
  @@index([tenant_id])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, due_date])
  @@index([tenant_id, status])
  @@map("sales")
}

model SaleItem {
  id                 String  @id @default(uuid()) @db.Uuid
  sale_id            String  @db.Uuid
  product_id         String  @db.Uuid
  product_snapshot   Json?   // immutable snapshot of product data
  batch_ids_used     Json?   // ids of InventoryStockBatch consumed (FIFO audit trail)
  quantity           Int
  selling_price      Decimal @db.Decimal(12, 2)
  cost_price         Decimal @db.Decimal(12, 2)
  line_profit        Decimal @db.Decimal(12, 2)

  sale    Sale             @relation(fields: [sale_id], references: [id])
  product InventoryProduct @relation(fields: [product_id], references: [id])

  @@index([sale_id])
  @@index([product_id])
  @@map("sale_items")
}

model SalePayment {
  id            String   @id @default(uuid()) @db.Uuid
  sale_id       String   @db.Uuid
  tenant_id     String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  method        String   // CASH / BANK_TRANSFER / CHECK / CREDIT_CARD
  reference     String?  // cheque number, transaction id, etc.
  received_date DateTime @default(now())
  received_by   String?
  notes         String?
  created_at    DateTime @default(now())

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id])
  @@index([tenant_id, received_date])
  @@map("sale_payments")
}

// =======================================
// 12. FINANCIAL LEDGER + PENDING SETTLEMENTS
// =======================================
model LedgerEntry {
  id                         String          @id @default(uuid()) @db.Uuid
  tenant_id                  String          @db.Uuid
  coa_id                     String?         @db.Uuid  // foreign key to ChartOfAccount
  party_type                 String          @default("GENERAL") // CUSTOMER / SUPPLIER / EMPLOYEE / GENERAL
  party_identifier           String          // legacy human-readable id
  party_id                   String?         @db.Uuid  // strongly-typed FK if applicable
  entry_type                 LedgerEntryType
  amount                     Decimal         @db.Decimal(12, 2)
  currency                   String          @default("EGP")
  reference_order_id         String?         @db.Uuid
  reference_sale_id          String?         @db.Uuid
  reference_payroll_period   String?
  authorized_action_by       String?
  source_whatsapp_message_id String?         @unique
  raw_message_text           String?
  narration                  String?
  created_at                 DateTime        @default(now())

  tenant Tenant            @relation(fields: [tenant_id], references: [id])
  coa    ChartOfAccount?   @relation(fields: [coa_id], references: [id], onDelete: SetNull)
  order  CustomerOrder?    @relation(fields: [reference_order_id], references: [id])
  sale   Sale?             @relation(fields: [reference_sale_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([tenant_id, party_type, party_identifier])
  @@index([tenant_id, coa_id])
  @@index([tenant_id, created_at])
  @@map("ledger_entries")
}

model PendingSettlement {
  id                         String                   @id @default(uuid()) @db.Uuid
  tenant_id                  String                   @db.Uuid
  party_identifier           String
  entry_type                 LedgerEntryType
  amount                     Decimal                  @db.Decimal(12, 2)
  requested_by               String                   // user id or whatsapp
  approver_id                String?                  // who approved (tenant user id)
  source_whatsapp_message_id String                   @unique
  raw_message_text           String
  status                     PendingSettlementStatus  @default(PENDING)
  rejection_reason           String?
  created_at                 DateTime                 @default(now())
  expires_at                 DateTime
  decided_at                 DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, requested_by, status])
  @@index([tenant_id, status, expires_at])
  @@map("pending_settlements")
}

model FinancialLedgerSummary {
  id                    String          @id @default(uuid()) @db.Uuid
  tenant_id             String          @db.Uuid
  party_identifier      String
  total_debit           Decimal         @db.Decimal(12, 2) @default(0)
  total_credit          Decimal         @db.Decimal(12, 2) @default(0)
  running_balance       Decimal         @db.Decimal(12, 2) @default(0)
  last_transaction_type LedgerEntryType?
  last_recalculated_at  DateTime        @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, party_identifier])
  @@index([tenant_id])
  @@map("financial_ledger_summaries")
}

// =======================================
// 13. HISTORY TABLES — NON-DESTRUCTIVE
// =======================================
model EmployeeRateHistory {
  id             String           @id @default(uuid()) @db.Uuid
  employee_id    String           @db.Uuid
  old_rate       Decimal          @db.Decimal(12, 2)
  new_rate       Decimal          @db.Decimal(12, 2)
  salary_type    SalaryType
  change_reason  RateChangeReason
  notes          String?
  effective_date DateTime         @db.Date
  applied_by     String?
  created_at     DateTime         @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([employee_id, effective_date])
  @@map("employee_rate_history")
}

model ProductPriceHistory {
  id             String            @id @default(uuid()) @db.Uuid
  product_id     String            @db.Uuid
  old_unit_price Decimal           @db.Decimal(12, 2)
  new_unit_price Decimal           @db.Decimal(12, 2)
  old_cost_price Decimal           @db.Decimal(12, 2)
  new_cost_price Decimal           @db.Decimal(12, 2)
  change_reason  PriceChangeReason
  notes          String?
  effective_date DateTime          @db.Date
  applied_by     String?
  created_at     DateTime          @default(now())

  product InventoryProduct @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@index([product_id, effective_date])
  @@map("product_price_history")
}
